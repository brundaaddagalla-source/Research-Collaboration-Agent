DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
FREELLMAPI_API_KEY=your_new_key_here

# Faculty Login (JWT auth) - optional, falls back to an insecure dev
# default if unset. Set a real random secret before deploying.
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRE_MINUTES=60

# Direct SMTP email (collaboration-request notifications) - no n8n/webhook
# automation. Use a Gmail "app password" if using Gmail SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Where the authority-review email is sent
AUTHORITY_EMAIL=

# Frontend URL used to build the Accept/Reject/Approve/Reject links
# embedded in collaboration-request emails
FRONTEND_BASE_URL=http://localhost:5173

# One-time email response tokens (Accept/Reject, Approve/Reject)
COLLAB_TOKEN_EXPIRE_HOURS=72

# Minimal shared-secret protection for the authority PATCH endpoint
# (the real-world authority workflow is the emailed one-time token link,
# which does not need this key). Leave unset to disable that endpoint.
AUTHORITY_API_KEY=

# Faculty research document uploads
RESEARCH_DOCS_STORAGE_DIR=storage/research_documents
RESEARCH_DOCS_MAX_FILE_SIZE_MB=20